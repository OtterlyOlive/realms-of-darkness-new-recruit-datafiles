              <profiles>
                <profile name="The Lion Court of Asfeluna" typeId="88d1-f569-0c9a-d4c2" typeName="Description" hidden="false" id="164a-9fbd-376f-5a2d">
                  <characteristics>
                    <characteristic name="Description" typeId="4255-c8e0-c029-6554">* Must take a Scion as a Lord choice in the army
* Can take Drake Pack as a Legendary choice in the army
* Can take Drakemasters as a Legendary choice in the army 
* Elven Warriors can buy Elven Heavy Armor for 3 points each. 
* Elven Light Chariots can buy Elven Medium Armor for 8 points per model
* Sisters of Yaldorei can buy Elven Heavy Armor for 2 points per model</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Dragon Court of Selva Unarith" hidden="false" id="a91e-434d-7c76-b3d3">
              <profiles>
                <profile name="The Dragon Court of Selva Unarith" typeId="88d1-f569-0c9a-d4c2" typeName="Description" hidden="false" id="788b-06d4-0b24-a0e5">
                  <characteristics>
                    <characteristic name="Description" typeId="4255-c8e0-c029-6554">* Can take a Beastmaster as a Lord choice in the army
* Can take Great Lion Pack as a Specialist choice in the army
* Can take Drake as a Legendary choice in the army 
* Elven Warriors, Elven Light Cavalry and Elven Heavy Cavalry can buy an axe for 1 point each, replacing their Elven Sword.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
