          <rules>
            <rule name="Abomination" id="d336-accb-f7eb-5220" hidden="false">
              <description>The character&apos;s appearance becomes horrible to look at, giving the character the Dread special rule.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="increment" value="30" field="5119-770c-ea3a-8a8c">
