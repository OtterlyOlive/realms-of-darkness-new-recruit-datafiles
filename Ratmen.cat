          </costs>
          <rules>
            <rule name="Surrounded by Flies" id="658a-1706-5c5d-f774" hidden="false">
              <description>All models in base to base contact with the character suffer -2WA</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4446-0633-bece-1f6c"/>
          </constraints>
          <modifiers>
            <modifier type="increment" value="15" field="5119-770c-ea3a-8a8c">
