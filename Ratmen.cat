        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Pestilence Breath" hidden="false" id="0da5-9a8b-ad19-949c">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <profiles>
            <profile name="Pestilence Breath" typeId="5bd5-5d91-38a8-7d3f" typeName="Ranged Weapon" hidden="false" id="a1cc-495f-e8d0-bab1">
              <characteristics>
                <characteristic name="Shots" typeId="557e-9928-a8b1-6e7d">D6</characteristic>
                <characteristic name="Power" typeId="0b26-95b4-94d7-6a08">4</characteristic>
                <characteristic name="Penalty" typeId="a0a5-6228-2857-07a0">-</characteristic>
                <characteristic name="Range" typeId="b7a5-a332-2148-9ea4">6&quot;</characteristic>
                <characteristic name="Type" typeId="3298-ada5-7b57-42ab">Breath</characteristic>
                <characteristic name="Special Rules" typeId="5353-ed52-2205-a615">Ignore Armour Saves</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8427-87dd-8764-5192"/>
          </constraints>
          <modifiers>
            <modifier type="increment" value="20" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Plague Spikes" hidden="false" id="bf3b-ea06-bdbb-e66a">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9b3a-cd3d-c596-c525"/>
          </constraints>
          <rules>
            <rule name="Plague Spikes" id="610a-8cd1-f243-dc9c" hidden="false">
              <description>Successful hits against the character in close combat cause a P5 hit to the attacker. The model can no longer wear armour.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="increment" value="20" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Venom Glands" hidden="false" id="68b1-f1fd-deb4-a900">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b702-b06c-874e-716a"/>
          </constraints>
          <infoLinks>
            <infoLink name="Poison" id="a69d-37da-9425-74a1" hidden="false" type="rule" targetId="ccf4-202b-cae8-196b"/>
          </infoLinks>
          <rules>
            <rule name="Venom Glands" id="82a0-4965-6680-50fe" hidden="false">
              <description>The hands of the character are soaked in venom. This gives the poison special rule to all attacks, both ranged and melee.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="increment" value="5" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hammer Fist" hidden="false" id="686f-52cc-b7c6-30a5">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c455-c6a4-beb1-a1fa"/>
          </constraints>
          <rules>
            <rule name="Hammer Fist" id="933b-7b08-77e1-2f41" hidden="false">
              <description>The hand of the character turns into a massive spiked bone hammer. The hand cannot carry items in the hand anymore, but gets +2P on attacks in close combat when attacking with that hand. It also counts as being equipped with a weapon.</description>
            </rule>
          </rules>
          <profiles>
            <profile name="Hammer Fist" typeId="090b-d919-0802-8838" typeName="Melee Weapon" hidden="false" id="db35-b81f-2cc7-fce8">
              <characteristics>
                <characteristic name="Power" typeId="a529-f46c-fe6f-4048">+2</characteristic>
                <characteristic name="Penalty" typeId="7761-068c-0a80-ee08">-</characteristic>
                <characteristic name="Type" typeId="d2bb-d955-061f-6146">Melee</characteristic>
                <characteristic name="Special Rules" typeId="c9c1-27d6-3445-a058"/>
              </characteristics>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="increment" value="15" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Blessing of Life" hidden="false" id="6710-e77d-7d9a-f9b7">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2672-b7d0-3fd7-115b"/>
          </constraints>
          <rules>
            <rule name="Blessing of Life" id="f455-f566-22f2-1b76" hidden="false">
              <description>Nurgast makes the body of the character unnaturally resilient but slow, giving the character +1HP and -2I (Already added to the profile of the model)</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="increment" value="15" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
            <modifier type="increment" value="1" field="c6ff-4f15-d25e-6719" scope="parent" affects="self.entries.recursive.profiles.Unit"/>
            <modifier type="floor" value="1" field="ee3f-1e0b-fdb1-af0d" affects="self.entries.recursive.profiles.Unit" scope="parent"/>
            <modifier type="decrement" value="2" field="ee3f-1e0b-fdb1-af0d" scope="parent" affects="self.entries.recursive.profiles.Unit"/>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Shika of the Deep" id="b518-29a2-d80b-922f" hidden="false">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Squid Tentacle" hidden="false" id="9335-35bd-713d-6173">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <rules>
            <rule name="Squid Tentacle" id="282a-a24d-5c9b-d877" hidden="false">
              <description>The character develops a squid tentacle instead of an arm. The increased mobility gives +1WA (Already added to the profile of the model)</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3042-f69d-d406-56a9"/>
          </constraints>
          <modifiers>
            <modifier type="increment" value="15" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
            <modifier type="increment" value="1" field="0f73-3c43-4701-9086" scope="parent" affects="self.entries.recursive.profiles.Unit"/>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Webbed Feet" hidden="false" id="8906-a6cc-02c6-ad53">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="24fd-db5e-bf04-a4f9"/>
          </constraints>
          <rules>
            <rule name="Webbed Feet" id="9f41-9351-e458-d9f7" hidden="false">
              <description>The character gets the Aquatic special rule and 1MD in watery pieces of terrain, like a swamp, river or the ocean.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink name="Aquatic" id="16b0-b6d6-c1a3-e055" hidden="false" type="rule" targetId="0790-2d67-b88b-2ae3"/>
          </infoLinks>
          <modifiers>
            <modifier type="increment" value="10" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Shark Eyes" hidden="false" id="16b6-ba34-c96b-3e20">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2ebb-44b9-0256-e241"/>
          </constraints>
          <rules>
            <rule name="Shark Eyes" id="afa7-497d-080a-0103" hidden="false">
              <description>+1WA while in watery pieces of terrain, like a swamp, river or the ocean.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="increment" value="5" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Fish Scales" hidden="false" id="778e-51e7-0e91-eb76">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d8aa-21f3-d130-95d6"/>
          </constraints>
          <entryLinks>
            <entryLink import="true" name="Tough Hide (6+/+1)" hidden="false" id="7721-70e7-a6ed-9591" type="selectionEntry" targetId="b99f-acad-90a6-df65">
              <constraints>
                <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0b10-84ce-ac9a-1a08-min"/>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0b10-84ce-ac9a-1a08-max"/>
              </constraints>
              <modifiers>
                <modifier type="set" value="Scaly Skin (6+ / +1)" field="name"/>
              </modifiers>
            </entryLink>
          </entryLinks>
          <rules>
            <rule name="Fish Scales" id="c7ac-3faa-214f-c4c7" hidden="false">
              <description>The character develops scaly skin of fish scales, giving a 6+/+1 scaly skin armour save.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="increment" value="10" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Gills" hidden="false" id="1888-d3f4-7ed0-a39a">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0f00-b543-3e72-88dc"/>
          </constraints>
          <rules>
            <rule name="Gills" id="9e75-506d-0f83-18f9" hidden="false">
              <description>The character develops gills and can breathe under water.


The character gets the Aquatic special rule and the Spy special rule.
* However the character can only use the Spy special rule to deploy in a watery piece of terrain, like a swamp, river or the ocean.
When deploying this way, the model can deploy down to 5” away instead of the normal distance for units with the Spy special rule.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink name="Spy" id="5ef1-b3c6-0f8a-7de1" hidden="false" type="rule" targetId="6537-b0fb-b259-b738">
              <modifiers>
                <modifier type="set" value="Spy (*)" field="name"/>
              </modifiers>
            </infoLink>
            <infoLink name="Aquatic" id="e53b-5ed2-fa93-9ec3" hidden="false" type="rule" targetId="0790-2d67-b88b-2ae3"/>
          </infoLinks>
          <modifiers>
            <modifier type="increment" value="20" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Crab Claw" hidden="false" id="395e-5ee6-6744-189a">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="0"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6c71-90b5-40c2-ba36"/>
          </constraints>
          <rules>
            <rule name="Crab Claw" id="c06e-15c1-33e2-81eb" hidden="false">
              <description>The arm and hand of the model is replaced by crab claws. The character gets +1P on attacks with the affected arm and +1 armour save for the exoskeleton. The character can not use armour larger than medium nor weapons of any kind in the affected arm. It also counts as being equipped with a weapon.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="increment" value="15" field="5119-770c-ea3a-8a8c">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="model" shared="true" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Magic Weapons" id="fb75-3065-3d16-84c7" hidden="false">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Boomstick" hidden="false" id="a3d7-5786-59ce-457c" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="8ba9-03df-9b11-5b87" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
          </constraints>
          <profiles>
            <profile name="Boomstick" typeId="5bd5-5d91-38a8-7d3f" typeName="Ranged Weapon" hidden="false" id="d501-e828-6bbc-435d">
              <characteristics>
                <characteristic name="Shots" typeId="557e-9928-a8b1-6e7d">1</characteristic>
                <characteristic name="Power" typeId="0b26-95b4-94d7-6a08">20</characteristic>
                <characteristic name="Penalty" typeId="a0a5-6228-2857-07a0">-</characteristic>
                <characteristic name="Range" typeId="b7a5-a332-2148-9ea4">15&quot;</characteristic>
                <characteristic name="Type" typeId="3298-ada5-7b57-42ab">Indirect</characteristic>
                <characteristic name="Special Rules" typeId="5353-ed52-2205-a615">Magic Attacks - Shadow, Volatile Shot</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Magic Attacks - X" id="20c6-cbe9-98c4-9c2b" hidden="false" targetId="b2ee-4ebe-97f3-3116" type="rule">
              <modifiers>
                <modifier type="set" value="Magic Attacks - Shadow" field="name"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="50"/>
          </costs>
          <rules>
            <rule name="Volatile Shot" id="4cf4-3b52-dd97-8f11" hidden="false">
              <description>The gun is extremely unstable and often hurts the rat using it.


On a roll of 1 to hit, the model carrying the weapon is hit instead of the target.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Rod of Corruption (Wizards only)" hidden="false" id="6b07-3ac9-6d83-6de9" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="8a7e-370f-faba-9e6c" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
          </constraints>
          <profiles>
            <profile name="Rod of Corruption" typeId="5bd5-5d91-38a8-7d3f" typeName="Ranged Weapon" hidden="false" id="14cf-1a58-a9a4-9a39">
              <characteristics>
                <characteristic name="Shots" typeId="557e-9928-a8b1-6e7d">3</characteristic>
                <characteristic name="Power" typeId="0b26-95b4-94d7-6a08">6</characteristic>
                <characteristic name="Penalty" typeId="a0a5-6228-2857-07a0">-</characteristic>
                <characteristic name="Range" typeId="b7a5-a332-2148-9ea4">20&quot;</characteristic>
                <characteristic name="Type" typeId="3298-ada5-7b57-42ab">Direct</characteristic>
                <characteristic name="Special Rules" typeId="5353-ed52-2205-a615">Corruption Madness, Magic Infusion, Magic Shot</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Magic Infusion" id="5132-5bbf-fefd-3016" hidden="false" type="rule" targetId="3f84-8a0e-f427-a82c"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="20"/>
          </costs>
          <rules>
            <rule name="Magic Shot" id="446b-846e-82f0-94d3" hidden="false">
              <description>The attack is magical of the type the wizard has.</description>
            </rule>
            <rule name="Corruption Madness" id="9342-5d99-588a-c2aa" hidden="false">
              <description>Whenever a model is killed by a shot from the staff, do not remove it. Instead put a counter on the unit.


The wizard can at any point later in the game in the magic phase spend a power token to activate all tokens on a unit. For each token a model in the unit will immediately attack the unit itself as if it was in melee in the melee phase and after it is done be removed as a casualty.


If this attack wounded but did not kill a model, add a new token to the unit, which the wizard can then later activate again with a power token.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="parent" childId="63a4-28ae-60e9-e0ff" shared="true"/>
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Spinesplitterz" hidden="false" id="e5ae-56c8-fc29-70f6">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="15"/>
          </costs>
          <profiles>
            <profile name="Spinesplitterz" typeId="090b-d919-0802-8838" typeName="Melee Weapon" hidden="false" id="649d-9aad-f190-252b">
              <characteristics>
                <characteristic name="Power" typeId="a529-f46c-fe6f-4048">User</characteristic>
                <characteristic name="Penalty" typeId="7761-068c-0a80-ee08">-</characteristic>
                <characteristic name="Type" typeId="d2bb-d955-061f-6146">Two-handed</characteristic>
                <characteristic name="Special Rules" typeId="c9c1-27d6-3445-a058">Armour Piercing, Closing the Distance, Spinesplitter</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Closing the Distance" id="581c-77d6-3325-e9eb" hidden="false" type="rule" targetId="e0e0-34ed-c43d-5df8"/>
            <infoLink name="Armour Piercing" id="938b-f1ac-c6a2-f8a1" hidden="false" type="rule" targetId="b97b-ad61-ed6d-219f"/>
          </infoLinks>
          <rules>
            <rule name="Spinesplitter" id="04d2-5d66-3277-7ef2" hidden="false">
              <description>This weapon is two daggers, giving +1A. Infantry, beast and cavalry type models suffering an unsaved wound from this weapon will instantly die and be removed as a casualty.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="7ded-c99e-fd2f-ab2b" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Magic Armours" id="c4f1-4ae7-d4ac-7c75" hidden="false">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Elfthing Plating" hidden="false" id="a066-0ccc-c8aa-c330">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="35"/>
          </costs>
          <profiles>
            <profile name="Elfthing Plating" typeId="2cbf-88e1-8eee-16a3" typeName="Armour" hidden="false" id="e1d2-455c-7901-47c7">
              <characteristics>
                <characteristic name="Save" typeId="4e87-a458-fe7d-8c9b">2+ / +5</characteristic>
                <characteristic name="Penalty" typeId="1ec1-f4db-6bb9-8a01">-2I</characteristic>
                <characteristic name="Type" typeId="a447-7f68-3e61-8845">Armour</characteristic>
                <characteristic name="Special Rules" typeId="03e6-32c2-e9e2-24d3">Mithril</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Mithril" id="dd4e-3779-0be8-c8c3" hidden="false" type="rule" targetId="6335-24fc-863b-7dbf"/>
          </infoLinks>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="82eb-eb7f-ffe5-3606" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Magic Trinkets" id="4623-9bad-d828-15a6" hidden="false">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Eye of Krittic" hidden="false" id="1e6f-8e2f-a7c7-31af">
          <rules>
            <rule name="Eye of Krittic" id="d2ed-9d5c-a115-bf75" hidden="false">
              <description>All ranged weapons in the army that shoot indirect fire share line of sight with the model holding this item, making them able to shoot at targets they otherwise cannot see. Note they still need to be in range to hit.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="20"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="c54d-ad36-584c-560d" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Bubonic Cloak" hidden="false" id="f916-bfe6-000a-9b82">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="35"/>
          </costs>
          <rules>
            <rule name="Bubonic Cloak" id="850e-e514-53a0-a0db" hidden="false">
              <description>All models, friendly or enemy in base contact with the model carrying the cloak, get -1 to hit in melee. Additionally the model gets the regeneration 5+ special rule.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="cbe2-78d8-ce08-59c8" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Rizzhud’s Lightning Rod" hidden="false" id="f738-f4aa-b343-ffe1">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="45"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="cce8-9bb8-e036-7b92" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Rizzhud’s Lightning Rod" id="aa4f-e70d-bc86-fcd0" hidden="false">
              <description>All spells targeting a unit within 6” of the model holding this item, will after the spell is cast be redirected to hit the wearer&apos;s unit instead of the intended target.


If the spell targets a specific model, the model holding the item is hit instead of the entire unit. Directional missile spells will turn directly toward the wearer when 6” away, permanently altering the course of the missile. This counts for both friendly and enemy spells.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Wizard’s Items" id="554e-f6d9-9b6c-d886" hidden="false">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Void Bomb" hidden="false" id="5480-5b14-a467-8d15">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="20"/>
          </costs>
          <profiles>
            <profile name="Void Bomb" typeId="5bd5-5d91-38a8-7d3f" typeName="Ranged Weapon" hidden="false" id="798c-90fb-01b4-f908">
              <characteristics>
                <characteristic name="Shots" typeId="557e-9928-a8b1-6e7d">1</characteristic>
                <characteristic name="Power" typeId="0b26-95b4-94d7-6a08">Equal to the amount of tokens on the item.</characteristic>
                <characteristic name="Penalty" typeId="a0a5-6228-2857-07a0">-</characteristic>
                <characteristic name="Range" typeId="b7a5-a332-2148-9ea4">15&quot;</characteristic>
                <characteristic name="Type" typeId="3298-ada5-7b57-42ab">Thrown</characteristic>
                <characteristic name="Special Rules" typeId="5353-ed52-2205-a615">Explosive Hit, Magic Attacks - Shadow</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Magic Attacks - X" id="1bca-6f8b-80b0-1ef4" hidden="false" type="rule" targetId="b2ee-4ebe-97f3-3116">
              <modifiers>
                <modifier type="set" value="Magic Attacks - Shadow" field="name"/>
              </modifiers>
            </infoLink>
            <infoLink name="Explosive Hit" id="64d5-a707-7271-f9c1" hidden="false" type="rule" targetId="e1d5-1e4e-e289-5201"/>
          </infoLinks>
          <rules>
            <rule name="Void Bomb" id="e9c0-b520-e9a6-f10a" hidden="false">
              <description>Whenever a spell fails to cast, due to the to cast roll not being high enough, secretly add a token to the void bomb. At the end of a magic phase where the owner has unused power tokens left, the bomb can be lit and then thrown in the move and shoot phase by the model holding it. As the bomb is lit, it must be announced to the opponent. It is treated as a ranged weapon with the following characteristics:
(See the Void Bomb ranged weapon in this profile)</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="6045-5844-0824-49ab" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Void Crystal" hidden="false" id="6ddf-6669-d83b-099b">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="10"/>
          </costs>
          <profiles>
            <profile name="Void Crystal" typeId="88d1-f569-0c9a-d4c2" typeName="Description" hidden="false" id="c4d7-19a9-035b-84d8">
              <characteristics>
                <characteristic name="Description" typeId="4255-c8e0-c029-6554">A void crystal can be used once per game when casting a spell. It adds a D8 to the total rolled to cast the spell. If a 1 is rolled on the D8, an overload occurs regardless of how much was rolled.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="4fcd-bcd8-a5a9-7647" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Chaos Powder" hidden="false" id="1b46-842d-8268-1f62">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="10"/>
          </costs>
          <rules>
            <rule name="Chaos Powder" id="c5d6-df8b-9b1b-4310" hidden="false">
              <description>Chaos powder can be used once per game when a spell that deals damage has been successfully cast. It adds +1P to the effect of the spell.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="3bc1-aba4-213d-e644" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Magic Banners" id="f355-2f91-336b-b839" hidden="false">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Void Banner" hidden="false" id="90b9-bd18-f457-7ed3">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="35"/>
          </costs>
          <profiles>
            <profile name="Void Banner" typeId="88d1-f569-0c9a-d4c2" typeName="Description" hidden="false" id="ea18-ac36-8541-fb25">
              <characteristics>
                <characteristic name="Description" typeId="4255-c8e0-c029-6554">The unit holding the banner gets the Mental Fortitude and the Magic Attacks - Shadow special rules.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Mental Fortitude" id="fe49-17a4-5bb7-6b34" hidden="false" type="rule" targetId="8bb5-917e-f208-d694"/>
            <infoLink name="Magic Attacks - X" id="99d0-8811-7ffb-972b" hidden="false" targetId="b2ee-4ebe-97f3-3116" type="rule">
              <modifiers>
                <modifier type="set" value="Magic Attacks - Shadow" field="name"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="7eb6-32db-3bf6-d35d" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Banner of the Horde" hidden="false" id="72d0-8995-9356-b8f2">
          <costs>
            <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="30"/>
          </costs>
          <profiles>
            <profile name="Banner of the Horde" typeId="88d1-f569-0c9a-d4c2" typeName="Description" hidden="false" id="6abb-ebb2-fc4a-4bfd">
              <characteristics>
                <characteristic name="Description" typeId="4255-c8e0-c029-6554">The unit holding the banner gets +2WP instead of +1WP for each rank in the unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="8243-6d74-9f1b-aade" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
