        <entryLink id="bb1f-dc8e-d146-cdaf" name="Sword" hidden="false" collective="false" import="true" targetId="2a90-b53f-66c2-2987" type="selectionEntry" sortIndex="2">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3e1d-0546-3a54-e4e2" type="max"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="86d4-c3dc-274a-9422" type="min"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <costs>
        <cost name="pts" typeId="5119-770c-ea3a-8a8c" value="30"/>
      </costs>
      <rules>
        <rule name="Overload" id="281c-ba3f-bb47-c331" hidden="false">
          <description>Each gun in the unit can choose to fire D8 extra shots before rolling the number of hits. 


Roll an extra D8 for each gun, if the number rolled on the second dice is equal to or higher than the number rolled on the first dice, add that number of shots.


If the number rolled on the second dice is lower than on the first, the gun explodes and the model is removed as a casualty. In this situation the first shots are fired, but no additional are added for the second dice.</description>
        </rule>
      </rules>
    </selectionEntry>
