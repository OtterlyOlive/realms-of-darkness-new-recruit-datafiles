          </modifiers>
        </infoLink>
        <infoLink name="Weakness - X" id="7b41-70d9-62a0-9b1a" hidden="false" type="rule" targetId="0651-7724-2b96-37dc">
          <modifiers>
            <modifier type="set" value="Weakness - Ice" field="name"/>
          </modifiers>
        </infoLink>
        <infoLink name="Large Monster" id="dc71-283b-380b-3715" hidden="false" type="infoGroup" targetId="965d-7455-ae5a-f12d"/>
      </infoLinks>
      <rules>
        <rule name="Rebirth of Fire" id="b318-ce41-5c98-471c" hidden="false">
          <description>The first time the phoenix dies or is run down in a battle, place a 5” diameter round marker on the location it died.
At the start of the following move and shoot phase, roll 6D6.
If one or more 4+ are rolled, the phoenix comes back with a number of HP equal to the amount of 4+ rolled.
It comes back on the marker and all models within the marker take a P6 hit with the Magic Attacks - Fire special rule.
The phoenix is flying low the turn it comes back like this. If flying is not possible, it counts as not flying and uses ground move instead. In the move and shoot phase it comes back, it has I1.
It can move and charge as normal. If it comes back inside an enemy unit, it counts as having charged into melee and is placed in the front of the enemy unit.
</description>
        </rule>
      </rules>
      <profiles>
        <profile name="Phoenix" typeId="9e8a-1733-b871-3826" typeName="Unit" hidden="false" id="2f20-1de5-14e8-d81e">
          <characteristics>
            <characteristic name="MD" typeId="d7a0-3cff-34c9-87ec">5&quot;</characteristic>
            <characteristic name="RH" typeId="b74f-2b64-2662-f401">-</characteristic>
